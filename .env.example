# Skopiuj do .env.local i uzupelnij. .env.local jest w .gitignore - klucze nie trafiaja do repo.
# Wartosci: panel Supabase / Vercel (Settings -> Environment Variables) albo od drugiej osoby.

# Supabase (Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Twelve Data - fallback kursow akcji i wyszukiwarki symboli (api/_lib/stock-price.js, symbol-search.js)
# Darmowy plan: https://twelvedata.com
TWELVE_DATA_API_KEY=

# GoldAPI - ceny surowcow (api/_lib/commodity-price.js). Darmowy plan: https://www.goldapi.io
GOLDAPI_KEY=

# Groq - streszczenia newsow AI i import zrzutu XTB (api/news-summary.js, api/xtb-screenshot.js)
# Darmowy plan: https://console.groq.com
GROQ_API_KEY=
