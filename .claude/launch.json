{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "moj-portfel",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "moj-portfel-vercel",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "vercel",
        "dev",
        "--listen",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "moj-portfel-sandbox",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--mode",
        "sandbox"
      ],
      "port": 5174,
      "autoPort": true
    }
  ]
}
